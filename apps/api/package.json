{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test --watch ",
    "test:ci": "bun test",
    "auth:generate": "bunx --bun @better-auth/cli generate --output ./coverage/schema.ts",
    "db:studio": "bun --env-file=.env.development drizzle-kit studio",
    "db:push": "bun --env-file=.env.development drizzle-kit push",
    "db:generate": "bun --env-file=.env.development drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.development drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "build": "bun build --compile --minify --sourcemap --target=bun-linux-x64-modern ./src/index.ts --outfile dist/app"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@elysiajs/cors": "1.4.0",
    "@elysiajs/openapi": "1.4.10",
    "@tqman/nice-logger": "1.1.1",
    "better-auth": "1.3.18",
    "better-auth-localization": "2.1.8",
    "drizzle-orm": "0.44.5",
    "drizzle-typebox": "0.3.3",
    "drizzle-zod": "0.8.3",
    "elysia": "1.4.7",
    "logixlysia": "5.1.1",
    "nodemailer": "7.0.6",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/nodemailer": "7.0.1",
    "bun-types": "latest",
    "drizzle-kit": "0.31.4"
  },
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.ts"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.0"
  }
}
