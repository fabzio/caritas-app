{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test --watch ",
    "test:ci": "bun test",
    "auth:generate": "bunx --bun @better-auth/cli generate --output ./coverage/schema.ts",
    "db:studio": "bun --env-file=.env.development drizzle-kit studio",
    "db:push": "bun --env-file=.env.development drizzle-kit push",
    "db:generate": "bun --env-file=.env.development drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.development drizzle-kit migrate",
    "db:seed": "bun --env-file=.env.development src/db/seed/index.ts",
    "build": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-x64-modern ./src/index.ts --outfile dist/app"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@elysiajs/cors": "1.4.0",
    "@elysiajs/eden": "1.4.4",
    "@elysiajs/openapi": "1.4.11",
    "@faker-js/faker": "10.1.0",
    "better-auth": "1.3.34",
    "better-auth-localization": "2.2.2",
    "drizzle-orm": "0.44.7",
    "drizzle-typebox": "0.3.3",
    "drizzle-zod": "0.8.3",
    "elysia": "1.4.15",
    "exceljs": "4.4.0",
    "logixlysia": "5.3.0",
    "nodemailer": "7.0.10",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/nodemailer": "7.0.3",
    "bun-types": "latest",
    "drizzle-kit": "0.31.6"
  },
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.ts"
  }
}
