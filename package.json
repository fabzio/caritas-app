{
  "name": "caritas-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test:ci",
    "lint": "biome check . --write",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "setup": "bun run scripts/develop.ts"
  },
  "lint-staged": {
    "*": "bun lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@commitlint/cli": "20.0.0",
    "@commitlint/config-conventional": "20.0.0",
    "@types/prompts": "2.4.9",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "16.2.1",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.2.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/minimatch": "6.0.0",
    "dotenv": "16.4.7",
    "execa": "9.4.0",
    "kleur": "4.1.5",
    "ora": "8.1.0",
    "prompts": "2.4.2"
  }
}
