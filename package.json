{
  "name": "caritas-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test:ci",
    "lint": "biome check . --write",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "setup": "bun run scripts/develop.ts",
    "terraform": "bun run scripts/terraform.ts"
  },
  "lint-staged": {
    "*": "bun lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@types/prompts": "2.4.9",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "16.2.6",
    "turbo": "2.6.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/minimatch": "6.0.0",
    "execa": "9.6.0",
    "kleur": "4.1.5",
    "ora": "9.0.0",
    "prompts": "2.4.2"
  }
}
